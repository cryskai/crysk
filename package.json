{
  "name": "pr-hero",
  "version": "0.2.6",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanmaagd/pr-hero.git"
  },
  "homepage": "https://github.com/juanmaagd/pr-hero#readme",
  "bugs": {
    "url": "https://github.com/juanmaagd/pr-hero/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#rereview/*": "./src/rereview/*.ts",
    "#ui/*": "./src/ui/*.ts",
    "#ci/*": "./src/ci/*.ts",
    "#store/*": "./src/store/*.ts",
    "#model/*": "./src/model/*.ts",
    "#triage/*": "./src/triage/*.ts",
    "#watch/*": "./src/watch/*.ts",
    "#corpus/*": "./src/corpus/*.ts",
    "#mcp/*": "./src/mcp/*.ts",
    "#server/*": "./src/server/*.ts",
    "#compare/*": "./src/compare/*.ts",
    "#review/*": "./src/review/*.ts",
    "#pr/*": "./src/pr/*.ts",
    "#git/*": "./src/git/*.ts",
    "#config/*": "./src/config/*.ts",
    "#commands/*": "./src/commands/*.ts"
  },
  "bin": {
    "pr-hero": "./bin/pr-hero.js"
  },
  "preferGlobal": true,
  "files": [
    "bin",
    "config",
    "dist",
    "prompts",
    "skills/crysk-loop",
    "skills/crysk-ci-setup",
    "skills/crysk-pr",
    "skills/crysk",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts src/index.ts --target=bun --outdir=dist",
    "review": "bun run src/cli.ts",
    "fixture-eval": "bun run scripts/fixture-eval.ts",
    "refuter-probe": "bun run scripts/refuter-probe.ts",
    "check": "biome check src test"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.25"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "optionalDependencies": {
    "bun": "1.3.14"
  }
}
